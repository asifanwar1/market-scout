# SQLite for now; switch to a Postgres URL (postgresql+psycopg2://...) when deploying.
DATABASE_URL=sqlite:///./market_scout.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Optional. Encrypts API keys saved from the UI. Leave empty to derive one from SECRET_KEY
# (then changing SECRET_KEY means re-entering saved keys). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Scouting ---
# Identifies this app to the free public services it calls (they ask clients to). Use a real
# address you read, or leave it blank: placeholders like you@example.com are refused (HTTP 406).
SCOUT_CONTACT_EMAIL=
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Minimum gap between OpenStreetMap requests; the public server throttles hard.
OVERPASS_MIN_INTERVAL_SECONDS=5
# Optional: Google Places key, used only if none is saved from the Settings screen.
GOOGLE_PLACES_API_KEY=
# Used for the run-cost preview only. Check Google's current pricing.
PLACES_COST_PER_REQUEST_USD=0.035
# Currency shown for deal values (the code or symbol you want on the pipeline screens, e.g. USD or PKR).
DEAL_CURRENCY=USD
# Optional: HERE and TomTom keys, used only if none is saved from the Sources screen.
HERE_API_KEY=
TOMTOM_API_KEY=
# Run-cost preview for HERE and TomTom. Both include a free allowance, so 0 shows $0.00 until you
# set the per-request price of your plan. Check each provider's current pricing and storage terms.
HERE_COST_PER_REQUEST_USD=0
TOMTOM_COST_PER_REQUEST_USD=0
# Set false to run without the background worker (runs then stay queued).
RUN_WORKER_ENABLED=true
# Largest number of searches one run may contain.
RUN_MAX_TASKS=2000
# A search finished within this many days is skipped when a run repeats it.
RUN_TASK_CACHE_DAYS=7
ENRICHMENT_CONCURRENCY=4
# Overture Maps: the local copy of Pakistan's places, made once with `python -m scripts.download_overture`.
OVERTURE_DB_PATH=./data/overture.sqlite
# Places Overture is less sure exist (0 to 1) are left out.
OVERTURE_MIN_CONFIDENCE=0.3
# Foursquare Places: the local copy of Pakistan's places, made once with `python -m scripts.download_foursquare --parquet <files>`.
FOURSQUARE_DB_PATH=./data/foursquare.sqlite

# --- File imports (CSV / Excel lists) ---
# Where an uploaded list waits while it is imported in the background.
IMPORTS_DIR=./imports
# Largest file and most rows one import may hold.
IMPORT_MAX_MB=10
IMPORT_MAX_ROWS=50000
# Rest between batches so the rest of the app can save while a big import runs.
IMPORT_BATCH_PAUSE_SECONDS=0.15

# --- Google Sheet live mirror ---
# Where Google's APIs live. Only change these to point at a test double.
SHEETS_API_URL=https://sheets.googleapis.com/v4
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# Optional: the service-account key file's whole JSON on one line. Used only if no key is saved
# from the Google Sheet screen (which is the easier way: paste it there).
GOOGLE_SERVICE_ACCOUNT_JSON=
# After leads change (a run, an edit, a do-not-contact) the sheet refreshes this many seconds
# later, so a burst of edits costs one update. Negative turns the automatic refresh off.
SHEETS_AUTO_SYNC_DELAY_SECONDS=20
