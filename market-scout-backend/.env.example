# SQLite for now; switch to a Postgres URL (postgresql+psycopg2://...) when deploying.
DATABASE_URL=sqlite:///./market_scout.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173

# Optional. Encrypts API keys saved from the UI. Leave empty to derive one from SECRET_KEY
# (then changing SECRET_KEY means re-entering saved keys). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Scouting ---
# Identifies this app to the free public services it calls (they ask clients to).
SCOUT_CONTACT_EMAIL=
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Minimum gap between OpenStreetMap requests; the public server throttles hard.
OVERPASS_MIN_INTERVAL_SECONDS=5
# Optional: Google Places key, used only if none is saved from the Settings screen.
GOOGLE_PLACES_API_KEY=
# Used for the run-cost preview only. Check Google's current pricing.
PLACES_COST_PER_REQUEST_USD=0.035
# Set false to run without the background worker (runs then stay queued).
RUN_WORKER_ENABLED=true
# Largest number of searches one run may contain.
RUN_MAX_TASKS=2000
# A search finished within this many days is skipped when a run repeats it.
RUN_TASK_CACHE_DAYS=7
ENRICHMENT_CONCURRENCY=4
